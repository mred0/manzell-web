# Copy this file to .env.local (which is gitignored) and fill in the three
# values from your Supabase project — see SUPABASE_SETUP.md for exactly
# where to find each one. The site and admin run fine without this file too
# (everything falls back to the static seed data in src/data/listings.ts),
# so there's no rush — add it whenever you're ready to switch on the
# database and the admin backend.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role (secret!)
# Server-only — never exposed to the browser, never commit this file.
SUPABASE_SERVICE_ROLE_KEY=
